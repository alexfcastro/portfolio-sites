{
  "name": "alex-castro-portfolio",
  "private": true,
  "description": "Monorepo do portfólio de Alex Castro (AX) e de suas futuras aplicações demonstrativas.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:portfolio": "pnpm --filter @ax/portfolio dev",
    "build:portfolio": "pnpm --filter @ax/portfolio build",
    "dev:barbearia": "pnpm --filter @ax/barbearia dev",
    "build:barbearia": "pnpm --filter @ax/barbearia build",
    "build": "pnpm --recursive --filter \"./apps/**\" build",
    "lint": "pnpm --recursive --filter \"./apps/**\" lint",
    "typecheck": "pnpm --recursive --filter \"./apps/**\" typecheck",
    "test": "pnpm --recursive --filter \"./apps/**\" test",
    "dev:clinica": "pnpm --filter @ax/clinica dev",
    "build:clinica": "pnpm --filter @ax/clinica build",
    "dev:restaurante": "pnpm --filter @ax/restaurante dev",
    "build:restaurante": "pnpm --filter @ax/restaurante build",
    "dev:oficina": "pnpm --filter @ax/oficina dev",
    "build:oficina": "pnpm --filter @ax/oficina build",
    "dev:servicos": "pnpm --filter @ax/servicos dev",
    "build:servicos": "pnpm --filter @ax/servicos build",
    "dev:autonomo": "pnpm --filter @ax/autonomo dev",
    "build:autonomo": "pnpm --filter @ax/autonomo build",
    "dev:advocacia": "pnpm --filter @ax/advocacia dev",
    "build:advocacia": "pnpm --filter @ax/advocacia build",
    "dev:imobiliaria": "pnpm --filter @ax/imobiliaria dev",
    "build:imobiliaria": "pnpm --filter @ax/imobiliaria build",
    "dev:petshop": "pnpm --filter @ax/petshop dev",
    "build:petshop": "pnpm --filter @ax/petshop build"
  }
}
