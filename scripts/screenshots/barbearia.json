    },
    {
      "name": "desktop-pix",
      "path": "/agendar",
      "width": 1440,
      "height": 900,
      "scale": 1,
      "steps": [
        "[...document.querySelectorAll('main button')].find(b => b.textContent.includes('Repetir')).click();",
        "document.querySelectorAll('input[name=time]')[2].click(); [...document.querySelectorAll('main button')].find(b => b.textContent.includes('Continuar')).click();",
        "[...document.querySelectorAll('main button')].find(b => b.textContent.includes('Confirmar')).click();",
        "document.querySelector('main section').scrollIntoView(); window.scrollBy(0, -90);"
      ]
    },
    {
      "name": "mobile-meus-horarios",
      "path": "/meus-horarios",
      "width": 390,
      "height": 844,
      "scale": 2,
      "mobile": true,
      "steps": [
        "[...document.querySelectorAll('main button')].find(b => b.textContent.includes('agora')).click();",
        "[...document.querySelectorAll('main button')].find(b => b.textContent.includes('Simular pagamento')).click();",
        "document.querySelector('#proximos-title').scrollIntoView(); window.scrollBy(0, -80);"
      ]
    },
    {
      "name": "desktop-painel",
      "path": "/admin",
      "width": 1440,
      "height": 900,
      "scale": 1,
      "steps": ["document.querySelector('#dia-title').scrollIntoView(); window.scrollBy(0, -90);"]
    },
    {
      "name": "desktop-faturamento",
      "path": "/admin",
      "width": 1440,
      "height": 900,
      "scale": 1,
      "steps": [
        "[...document.querySelectorAll('[role=tab]')].find(b => b.textContent.includes('Faturamento')).click();",
        "document.querySelector('#estimativa-title').scrollIntoView(); window.scrollBy(0, -90);"
      ]
    },
    {
      "name": "desktop-grade",
      "path": "/admin",
      "width": 1440,
      "height": 900,
      "scale": 1,
      "steps": [
        "[...document.querySelectorAll('[role=tab]')].find(b => b.textContent.includes('Agenda')).click();",
        "document.querySelectorAll('input[name=grade-dia]')[1].click();",
        "document.querySelector('#grade-title').scrollIntoView(); window.scrollBy(0, -90);"
      ]
