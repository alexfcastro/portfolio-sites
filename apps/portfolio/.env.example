# Portfólio Alex Castro — variáveis PÚBLICAS (embutidas no build).
# Copie para .env.local e preencha só o que existir de verdade.
# Tudo é opcional: sem valores, o site roda em modo prévia, sem links de contato.
# Não coloque segredos aqui — variáveis NEXT_PUBLIC_ ficam visíveis no navegador.
# Alterar qualquer valor exige novo build/deploy.

# Ambiente de publicação: development | preview | production
# Somente "production" com NEXT_PUBLIC_SITE_URL válida permite indexação e sitemap.
NEXT_PUBLIC_DEPLOY_ENV=development

# URL pública canônica do portfólio (https, sem barra final). Única fonte para
# canonical, Open Graph e sitemap. Deixe vazio até existir uma URL real.
NEXT_PUBLIC_SITE_URL=

# WhatsApp de Alex com código do país, só dígitos ou formatado. Ex.: 5511912345678
NEXT_PUBLIC_CONTACT_WHATSAPP=
# E-mail de contato real
NEXT_PUBLIC_CONTACT_EMAIL=
# Opcional: como exibir o telefone (senão é formatado automaticamente)
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=

# Perfis (apenas https)
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_GITHUB=

# Localização: preencher somente com dados confirmados
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_SERVICE_AREA=

# URLs das demos independentes (apps/<slug>). Uma URL aqui NÃO libera o botão
# "Abrir demonstração": o estado da demo precisa ser "available" em src/data/projects.ts.
NEXT_PUBLIC_DEMO_URL_BARBEARIA=
NEXT_PUBLIC_DEMO_URL_CLINICA=
NEXT_PUBLIC_DEMO_URL_RESTAURANTE=
NEXT_PUBLIC_DEMO_URL_OFICINA=
NEXT_PUBLIC_DEMO_URL_SERVICOS=
NEXT_PUBLIC_DEMO_URL_AUTONOMO=
NEXT_PUBLIC_DEMO_URL_ADVOCACIA=
NEXT_PUBLIC_DEMO_URL_IMOBILIARIA=
NEXT_PUBLIC_DEMO_URL_PETSHOP=
NEXT_PUBLIC_DEMO_URL_ACADEMIA=
NEXT_PUBLIC_DEMO_URL_PRODUTOS_NATURAIS=
NEXT_PUBLIC_DEMO_URL_FLORICULTURA=
