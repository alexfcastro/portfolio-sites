# PetVille (demo) — variáveis PÚBLICAS, embutidas no build.
# Copie para apps/barbearia/.env.local. Alterar exige novo build/deploy.

# development | preview | production (a demo é sempre noindex, em qualquer ambiente)
NEXT_PUBLIC_DEPLOY_ENV=development

# URL pública do portfólio de Alex Castro, sem barra final.
# Usada em "Voltar ao portfólio", "Ver case" e "Solicitar um site como este".
# Em `next dev`, se vazia, usa http://localhost:3000. Em build, se vazia, esses links somem.
NEXT_PUBLIC_PORTFOLIO_URL=
